# Maintainer: Raticode <maintainers@raticode.local>
pkgname=raticode-cli
pkgver=0.5.1
pkgrel=1
pkgdesc="Command line workflow automation tool for Raticode"
arch=("x86_64")
url="https://github.com/zacharyivie/Raticode"
license=("AGPL-3.0-only")
# Earlier local builds used the previous package name and installed /usr/bin/gof.
conflicts=("gofer-flow-cli")
replaces=("gofer-flow-cli")
options=(!strip)
source_x86_64=(
  "raticode-cli-linux-x64-${pkgver}::${url}/releases/download/v${pkgver}/raticode-cli-linux-x64"
)
sha256sums_x86_64=(
  "SKIP"
)

package() {
  install -Dm755 "${srcdir}/raticode-cli-linux-x64-${pkgver}" "${pkgdir}/usr/bin/Raticode"
}
