# Maintainer: Raticode <maintainers@raticode.local>
pkgname=raticode-desktop
pkgver=0.5.2
pkgrel=1
pkgdesc="Local workflow automation studio for Raticode"
arch=("x86_64")
url="https://github.com/zacharyivie/Raticode"
license=("AGPL-3.0-only")
# Earlier local builds used the previous package name.
conflicts=("gofer-flow")
replaces=("gofer-flow")
depends=(
  "fuse2"
  "gtk3"
  "hicolor-icon-theme"
  "libxss"
  "libxtst"
  "nss"
  "xdg-utils"
)
options=(!strip)
source_x86_64=(
  "Raticode-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/Raticode-${pkgver}-x86_64.AppImage"
)
source=(
  "raticode-desktop"
  "raticode-desktop.desktop"
  "raticode.svg"
)
sha256sums=('1a6a0c8e05f91a1f4ae1d417bf1006af566ce92df78c649069f982fbbdc592d6'
            'c54141d20d909f768237f22e7dac7a7e26cd5e8eaee560a3e4eacceb355a894f'
            '5f23b392f8adf4b863c4a03c47319aaafba72b762830a4427272c6ab71f8f6e1')
sha256sums_x86_64=('9e20abc5d50c308344a434b528b91e9f8a360f028248cb8b1d3cd0ad4440fb08')

package() {
  install -Dm755 "${srcdir}/Raticode-${pkgver}-x86_64.AppImage" \
    "${pkgdir}/opt/raticode-desktop/Raticode.AppImage"
  install -Dm755 "${srcdir}/raticode-desktop" "${pkgdir}/usr/bin/raticode-desktop"
  install -Dm644 "${srcdir}/raticode-desktop.desktop" \
    "${pkgdir}/usr/share/applications/raticode-desktop.desktop"
  install -Dm644 "${srcdir}/raticode.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/raticode.svg"
}
