{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "bash-command",
  "runtime_handler": "raticode.bash_command",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "command": {"type": "string", "minLength": 1},
      "working_dir": {"type": ["string", "null"], "x-rattish-type": "Path"},
      "env": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    },
    "required": ["command"],
    "additionalProperties": false
  },
  "defaults": {
    "working_dir": null,
    "env": {}
  },
  "computed_defaults": {},
  "input_ports": {
    "mode": "open",
    "ports": {
      "stdin": {
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string"
        },
        "required": false,
        "delivery": "stdin",
        "encoding": "utf8",
        "description": "Text supplied to the command's standard input."
      }
    },
    "additional_port_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "additional_port_delivery": {
      "delivery": "environment",
      "name_transform": "kebab_to_upper_snake",
      "encoding": "string_or_canonical_json"
    }
  },
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "exit_code": {"type": "integer"}
      },
      "required": ["stdout", "stderr", "exit_code"],
      "additionalProperties": false
    }
  },
  "error_kinds": [
    "cancelled",
    "command",
    "configuration",
    "filesystem",
    "internal",
    "timeout"
  ],
  "effects": ["command", "filesystem_read", "filesystem_write"],
  "preflight_checks": [
    {
      "id": "shell-available",
      "severity": "error",
      "description": "The configured Bash runtime must be available."
    },
    {
      "id": "working-dir-available",
      "severity": "error",
      "description": "A selected working directory must exist and be accessible."
    }
  ],
  "static_diagnostics": [
    {
      "code": "RATTISH_SUSPECTED_PLAINTEXT_SECRET",
      "severity": "warning",
      "rule": "suspected_plaintext_secret",
      "fields": ["env"],
      "description": "Warn about credential-shaped plaintext environment entries without rejecting the source."
    }
  ],
  "runtime_environment": {
    "sources_low_to_high_precedence": [
      "inherited_process",
      "node_configuration",
      "input_bindings"
    ],
    "ambient_values_affect_compilation": false
  }
}
