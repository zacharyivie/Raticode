{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "jev",
  "runtime_handler": "raticode.jev",
  "catalog": {"category": "ai", "summary": "Ask Jev a yes/no or multiple-choice question and route on the answer", "docs_path": "/docs/nodes/jev"},
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "question": {"description": "The question Jev answers about the state.", "type": "string", "minLength": 1},
      "question_type": {
        "description": "A yes/no question or a pick among options.",
        "type": "string",
        "enum": ["yes-no", "choice"],
        "x-rattish-case-insensitive": true
      },
      "criteria": {
        "description": "What counts as yes and as no. Yes/no only.",
        "type": "object",
        "properties": {
          "yes": {"description": "What counts as yes.", "type": "string", "minLength": 1},
          "no": {"description": "What counts as no.", "type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "options": {
        "description": "2 to 255 option names, each mapped to a description. Choice only.",
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "threshold": {"description": "Lowest score that counts as yes. Yes/no only.", "type": "number", "minimum": 0, "maximum": 1},
      "state": {"description": "The text the question is about.", "type": "string"},
      "model": {"description": "Jev model version.", "type": "string", "minLength": 1},
      "long_context": {"description": "Allow up to 262k tokens instead of 64k. Slower and less accurate, per TypeSafe.", "type": "boolean"},
      "request_timeout": {"description": "Limit for one call to Jev, at most 60s. The shared timeout limits the whole node.", "type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m)$"},
      "cache": {"description": "Reuse a saved answer for this long, such as 12h or 7d, at most 365d.", "type": ["string", "null"], "pattern": "^[1-9][0-9]*(s|m|h|d|w)$"}
    },
    "required": ["question"],
    "additionalProperties": false
  },
  "defaults": {
    "question_type": "yes-no",
    "criteria": {},
    "options": {},
    "threshold": 0.5,
    "state": "",
    "model": "jev-1.14.0",
    "long_context": false,
    "request_timeout": "15s",
    "cache": null
  },
  "computed_defaults": {},
  "input_ports": {
    "mode": "closed",
    "ports": {
      "state": {
        "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema"},
        "required": false,
        "delivery": "local_binding",
        "encoding": "identity",
        "description": "The text or JSON the question is about. Overrides the authored state."
      },
      "question": {
        "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string"},
        "required": false,
        "delivery": "local_binding",
        "encoding": "identity"
      }
    }
  },
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "probabilities": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "question_type": {"type": "string", "enum": ["yes-no", "choice"]},
        "threshold": {"type": ["number", "null"]},
        "model": {"type": "string"},
        "requested_model": {"type": "string"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0}
      },
      "required": [
        "label",
        "score",
        "probabilities",
        "question_type",
        "threshold",
        "model",
        "requested_model",
        "input_tokens",
        "output_tokens",
        "latency_ms"
      ],
      "additionalProperties": false
    }
  },
  "error_kinds": [
    "cancelled",
    "configuration",
    "internal",
    "network",
    "output_validation",
    "provider",
    "timeout"
  ],
  "effects": ["network", "provider"],
  "preflight_checks": [
    {
      "id": "jev-configured",
      "severity": "error",
      "description": "Save a Jev key in Settings > Providers > Jev and keep Jev turned on."
    }
  ],
  "static_diagnostics": []
}
