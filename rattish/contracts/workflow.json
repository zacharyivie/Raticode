{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "workflow",
  "runtime_handler": "raticode.workflow",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflow_id": {
        "type": "string",
        "minLength": 1,
        "x-rattish-allow-absence": true
      },
      "workflow_path": {
        "type": "string",
        "minLength": 1,
        "x-rattish-type": "Path",
        "x-rattish-allow-absence": true
      },
      "version": {"type": ["integer", "null"], "minimum": 1}
    },
    "oneOf": [
      {"required": ["workflow_id"]},
      {"required": ["workflow_path"]}
    ],
    "additionalProperties": false
  },
  "defaults": {
    "version": null
  },
  "computed_defaults": {
    "version": {
      "source": "referenced_workflow",
      "field": "interface_version",
      "description": "Resolve an omitted version to the current child interface version and freeze it in IR."
    }
  },
  "input_ports": {
    "mode": "referenced_workflow",
    "ports": {},
    "interface_source": "referenced_workflow"
  },
  "success_output": {
    "kind": "referenced_workflow",
    "interface_source": "referenced_workflow"
  },
  "error_kinds": [
    "cancelled",
    "child_workflow",
    "configuration",
    "internal",
    "output_validation",
    "timeout"
  ],
  "effects": ["workflow_call"],
  "preflight_checks": [
    {
      "id": "child-workflow-ready",
      "severity": "error",
      "description": "The resolved child workflow must pass deployment preflight."
    }
  ],
  "static_diagnostics": []
}
