{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "open-resource",
  "runtime_handler": "raticode.open_resource",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "target": {"type": "string", "minLength": 1},
      "resource_type": {"enum": ["auto", "file", "folder", "url", "app"], "x-rattish-case-insensitive": true},
      "args": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["target"],
    "additionalProperties": false
  },
  "defaults": {"resource_type": "auto", "args": []},
  "computed_defaults": {},
  "input_ports": {"mode": "closed", "ports": {}},
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "target": {"type": "string"},
        "resource_type": {"enum": ["file", "folder", "url", "app"]}
      },
      "required": ["target", "resource_type"],
      "additionalProperties": false
    }
  },
  "error_kinds": ["cancelled", "command", "configuration", "filesystem", "internal", "output_validation", "timeout"],
  "effects": ["command", "filesystem_read"],
  "preflight_checks": [
    {"id": "target-ready", "severity": "error", "description": "The target must match its declared resource type and be accessible."},
    {"id": "opener-available", "severity": "error", "description": "The platform resource opener or selected application must be available."}
  ],
  "static_diagnostics": []
}
