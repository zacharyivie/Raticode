{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "agent",
  "runtime_handler": "raticode.agent",
  "catalog": {"category": "ai", "summary": "Ask an AI provider to do a task you describe", "docs_path": "/docs/nodes/agent"},
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"description": "Rattish provider ID.", "type": "string", "minLength": 1, "x-rattish-role": "provider_id"},
      "profile": {"description": "Optional compatible deployment profile, or one of the provider's accounts.", "type": ["string", "null"]},
      "model": {"description": "Model ID supported by the selected provider.", "type": "string", "minLength": 1},
      "effort": {"description": "Effort choice supported by that model.", "type": "string", "minLength": 1},
      "working_dir": {"description": "Working directory resolved from the workflow project.", "type": "string", "x-rattish-type": "Path"},
      "prompt": {"description": "Inline task prompt.", "type": "string"},
      "prompt_path": {"description": "Readable prompt source file.", "type": ["string", "null"], "x-rattish-type": "Path"},
      "skill": {"description": "Selected skill reference.", "type": ["string", "null"]},
      "memory": {"description": "Provider memory scope.", "enum": ["none", "run", "all"]},
      "tools": {"description": "Selected provider tools.", "type": "array", "items": {"type": "string"}},
      "mcp_servers": {"description": "Names of MCP servers the provider already has set up.", "type": "array", "items": {"type": "string"}},
      "env": {
        "description": "Additional string environment values.",
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "extra_paths": {
        "description": "Additional authored resource paths.",
        "type": "array",
        "items": {"type": "string", "x-rattish-type": "Path"}
      },
      "output_schema": {"description": "Inline successful-output JSON Schema.", "type": ["object", "null"]},
      "output_schema_path": {"description": "File containing the successful-output schema.", "type": ["string", "null"], "x-rattish-type": "Path"},
      "repair_attempts": {"description": "Bounded structured-output repair attempts.", "type": "integer", "minimum": 0, "maximum": 3},
      "sandbox": {"description": "Set to off to run the step without its operating-system sandbox.", "enum": ["on", "off"]},
      "network": {
        "description": "Hosts the step's shell may reach.",
        "anyOf": [
          {"const": "any"},
          {"type": "null"},
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(localhost|(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+)$"
            },
            "uniqueItems": true
          }
        ]
      },
      "fallback": {
        "description": "Providers to try next when this one can't serve the step.",
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "provider": {"description": "Provider ID to try.", "type": "string", "minLength": 1, "x-rattish-role": "provider_id"},
            "profile": {"description": "Optional profile or account for that provider.", "type": ["string", "null"]},
            "model": {"description": "Optional model for that provider.", "type": "string", "minLength": 1},
            "effort": {"description": "Optional effort for that model.", "type": "string", "minLength": 1}
          },
          "required": ["provider"],
          "additionalProperties": false
        }
      }
    },
    "required": ["provider"],
    "allOf": [
      {
        "not": {
          "properties": {
            "output_schema": {"type": "object"},
            "output_schema_path": {"type": "string"}
          },
          "required": ["output_schema", "output_schema_path"]
        }
      }
    ],
    "additionalProperties": false
  },
  "defaults": {
    "profile": null,
    "working_dir": ".",
    "prompt": "",
    "prompt_path": null,
    "skill": null,
    "memory": "none",
    "tools": [],
    "mcp_servers": [],
    "env": {},
    "extra_paths": [],
    "output_schema": null,
    "output_schema_path": null,
    "repair_attempts": 0,
    "sandbox": "on",
    "network": [],
    "fallback": []
  },
  "computed_defaults": {
    "model": {
      "source": "provider_contract",
      "field": "default_model",
      "description": "Resolve the provider contract's default model and freeze it in IR."
    },
    "effort": {
      "source": "provider_contract",
      "field": "default_effort",
      "description": "Resolve the provider contract's default effort and freeze it in IR."
    }
  },
  "input_ports": {
    "mode": "open",
    "ports": {},
    "additional_port_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "additional_port_delivery": {
      "delivery": "local_binding",
      "name_transform": "identity",
      "encoding": "identity"
    }
  },
  "success_output": {
    "kind": "configuration_selected",
    "schema_fields": ["output_schema", "output_schema_path"],
    "default_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string"
    }
  },
  "error_kinds": [
    "budget",
    "cancelled",
    "configuration",
    "filesystem",
    "internal",
    "output_validation",
    "provider",
    "timeout"
  ],
  "effects": ["filesystem_read", "filesystem_write", "network", "provider"],
  "preflight_checks": [
    {
      "id": "provider-available",
      "severity": "error",
      "description": "The selected provider runtime must be installed and available."
    },
    {
      "id": "profile-compatible",
      "severity": "error",
      "description": "A selected deployment profile must exist and support the provider."
    },
    {
      "id": "fallback-provider-available",
      "severity": "warning",
      "description": "Each fallback provider should be installed and available, so the step can switch to it."
    },
    {
      "id": "prompt-path-readable",
      "severity": "error",
      "description": "A selected prompt path must exist and be readable."
    },
    {
      "id": "working-dir-available",
      "severity": "error",
      "description": "The working directory must exist and be accessible."
    },
    {
      "id": "sandbox-available",
      "severity": "error",
      "description": "The step's operating-system sandbox must be able to start with its provider, profile and network setting."
    },
    {
      "id": "network-declared",
      "severity": "error",
      "description": "Hosts the agent's shell needs must be listed in the step's network field."
    },
    {
      "id": "runs-unsandboxed",
      "severity": "warning",
      "description": "Steps on a provider without a sandbox, on native Windows or with sandbox: off run unsandboxed."
    },
    {
      "id": "extra-paths-allowed",
      "severity": "error",
      "description": "An extra path can't be, hold or sit inside a folder where Raticode or your home folder keeps credentials."
    },
    {
      "id": "sandbox-widened",
      "severity": "warning",
      "description": "Extra paths outside the project and network: any let the step's shell reach more than its project."
    }
  ],
  "static_diagnostics": [
    {
      "code": "RATTISH_MUTUALLY_EXCLUSIVE_FIELDS",
      "severity": "error",
      "rule": "mutually_exclusive_fields",
      "fields": ["prompt", "prompt_path"],
      "description": "Inline prompt and prompt path cannot both be authored."
    },
    {
      "code": "RATTISH_BLANK_AGENT_PROMPT",
      "severity": "warning",
      "rule": "blank_prompt",
      "fields": ["prompt", "prompt_path"],
      "description": "Warn when the Agent has no inline prompt and no prompt path."
    },
    {
      "code": "RATTISH_SUSPECTED_PLAINTEXT_SECRET",
      "severity": "warning",
      "rule": "suspected_plaintext_secret",
      "fields": ["env"],
      "description": "Warn about credential-shaped plaintext environment entries without rejecting the source."
    },
    {
      "code": "RATTISH_AGENT_SANDBOX_OFF",
      "severity": "warning",
      "rule": "sandbox_off",
      "fields": ["sandbox"],
      "description": "Warn when an agent step turns off its operating-system sandbox."
    }
  ]
}
