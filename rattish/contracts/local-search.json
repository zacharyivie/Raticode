{
  "$schema": "../schemas/node-contract.schema.json", "contract_version": 1, "node_type": "local-search", "runtime_handler": "raticode.local_search",
  "configuration_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {
    "index_path": {"type": "string", "x-rattish-type": "Path"}, "query": {"type": "string"}, "top_k": {"type": "integer", "minimum": 1},
    "score_threshold": {"type": "number", "minimum": -1, "maximum": 1}, "include_snippets": {"type": "boolean"}, "include_file_metadata": {"type": "boolean"},
    "embedding_strategy": {"type": "string", "minLength": 1}, "search_strategy": {"type": "string", "minLength": 1}
  }, "required": ["index_path", "query"], "additionalProperties": false},
  "defaults": {"top_k": 5, "score_threshold": 0.0, "include_snippets": true, "include_file_metadata": true, "embedding_strategy": "hash_token_v1", "search_strategy": "cosine_v1"},
  "computed_defaults": {}, "input_ports": {"mode": "closed", "ports": {"query": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string"}, "required": false, "delivery": "local_binding", "encoding": "identity"}}},
  "success_output": {"kind": "fixed", "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"query": {"type": "string"}, "index_path": {"type": "string"}, "count": {"type": "integer"}, "results": {"type": "array", "items": {"type": "object"}}}, "required": ["query", "index_path", "count", "results"], "additionalProperties": false}},
  "error_kinds": ["configuration", "filesystem", "internal", "output_validation"], "effects": ["filesystem_read"],
  "preflight_checks": [{"id": "index-readable", "severity": "error", "description": "The local vector index must exist and be readable."}, {"id": "strategy-available", "severity": "error", "description": "The configured embedding and search strategy pair must be installed."}], "static_diagnostics": []
}
