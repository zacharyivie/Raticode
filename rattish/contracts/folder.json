{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "folder",
  "runtime_handler": "raticode.folder",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "x-rattish-type": "Path"}
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "defaults": {},
  "computed_defaults": {},
  "input_ports": {"mode": "closed", "ports": {}},
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "folder_path": {"type": "string"},
        "folder_name": {"type": "string"},
        "parent_path": {"type": "string"},
        "directory": {"type": "string"}
      },
      "required": ["path", "folder_path", "folder_name", "parent_path", "directory"],
      "additionalProperties": false
    }
  },
  "error_kinds": ["cancelled", "configuration", "filesystem", "internal", "output_validation", "timeout"],
  "effects": ["filesystem_read"],
  "preflight_checks": [
    {"id": "path-readable", "severity": "error", "description": "The selected folder must exist and be accessible."}
  ],
  "static_diagnostics": []
}
