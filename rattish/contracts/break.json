{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "break",
  "runtime_handler": "raticode.break",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "loop": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "x-rattish-type": "NodeID<loop>"
      },
      "message": {"type": "string"}
    },
    "required": ["loop"],
    "additionalProperties": false
  },
  "defaults": {
    "message": ""
  },
  "computed_defaults": {},
  "input_ports": {
    "mode": "closed",
    "ports": {}
  },
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "loop": {"type": "string"},
        "message": {"type": "string"}
      },
      "required": ["loop", "message"],
      "additionalProperties": false
    }
  },
  "error_kinds": ["internal"],
  "effects": ["workflow_control"],
  "preflight_checks": [],
  "static_diagnostics": []
}
