{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "delete-file",
  "runtime_handler": "raticode.delete_file",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "x-rattish-type": "Path"},
      "use_trash": {"type": "boolean"},
      "recursive": {"type": "boolean"},
      "missing_ok": {"type": "boolean"}
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "defaults": {"use_trash": true, "recursive": false, "missing_ok": false},
  "computed_defaults": {},
  "input_ports": {"mode": "closed", "ports": {}},
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "path_kind": {"enum": ["file", "directory", "symlink", "missing"]},
        "disposition": {"enum": ["trashed", "deleted", "missing"]},
        "trash_path": {"type": ["string", "null"]}
      },
      "required": ["path", "path_kind", "disposition", "trash_path"],
      "additionalProperties": false
    }
  },
  "error_kinds": ["cancelled", "configuration", "filesystem", "internal", "output_validation", "timeout"],
  "effects": ["filesystem_write"],
  "preflight_checks": [
    {"id": "path-policy", "severity": "error", "description": "The target must remain inside the workflow project root."},
    {"id": "target-ready", "severity": "error", "description": "The target must satisfy missing and recursive deletion policy."},
    {"id": "trash-ready", "severity": "error", "description": "Trash storage must be available when trash deletion is selected."}
  ],
  "static_diagnostics": []
}
