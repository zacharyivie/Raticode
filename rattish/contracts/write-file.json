{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "write-file",
  "runtime_handler": "raticode.write_file",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1, "x-rattish-type": "Path"},
      "content": {"type": "string"},
      "encoding": {"type": "string", "minLength": 1},
      "create_dirs": {"type": "boolean"},
      "overwrite": {"type": "boolean"},
      "append": {"type": "boolean"}
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "defaults": {"content": "", "encoding": "utf-8", "create_dirs": true, "overwrite": true, "append": false},
  "computed_defaults": {},
  "input_ports": {
    "mode": "closed",
    "ports": {
      "stdin": {
        "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string"},
        "required": false,
        "delivery": "stdin",
        "encoding": "utf8",
        "description": "Text that overrides authored content for this run."
      }
    }
  },
  "success_output": {
    "kind": "fixed",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "action": {"enum": ["created", "replaced", "appended"]},
        "bytes_written": {"type": "integer", "minimum": 0},
        "characters_written": {"type": "integer", "minimum": 0}
      },
      "required": ["path", "action", "bytes_written", "characters_written"],
      "additionalProperties": false
    }
  },
  "error_kinds": ["cancelled", "configuration", "filesystem", "internal", "output_validation", "timeout"],
  "effects": ["filesystem_write"],
  "preflight_checks": [
    {"id": "path-policy", "severity": "error", "description": "The destination must remain inside the workflow project root."},
    {"id": "destination-ready", "severity": "error", "description": "The destination must be writable under the authored overwrite and directory policy."},
    {"id": "encoding-supported", "severity": "error", "description": "The selected text encoding must be supported."}
  ],
  "static_diagnostics": []
}
