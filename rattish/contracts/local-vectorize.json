{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "local-vectorize",
  "runtime_handler": "raticode.local_vectorize",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
    "properties": {
      "source_path": {"type": "string", "x-rattish-type": "Path"}, "index_path": {"type": "string", "x-rattish-type": "Path"},
      "glob": {"type": "string"}, "recursive": {"type": "boolean"}, "chunk_size": {"type": "integer", "minimum": 1},
      "chunk_overlap": {"type": "integer", "minimum": 0}, "encoding": {"type": "string"},
      "mode": {"enum": ["incremental", "full", "validate"], "x-rattish-case-insensitive": true},
      "embedding_strategy": {"type": "string", "minLength": 1}, "search_strategy": {"type": "string", "minLength": 1}
    },
    "required": ["source_path", "index_path"], "additionalProperties": false
  },
  "defaults": {"glob": "**/*", "recursive": true, "chunk_size": 1200, "chunk_overlap": 120, "encoding": "utf-8", "mode": "incremental", "embedding_strategy": "hash_token_v1", "search_strategy": "cosine_v1"},
  "computed_defaults": {}, "input_ports": {"mode": "closed", "ports": {}},
  "success_output": {"kind": "fixed", "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"source_path": {"type": "string"}, "index_path": {"type": "string"}, "mode": {"type": "string"}, "status": {"enum": ["current", "stale", "updated"]}, "current": {"type": "boolean"}, "file_count": {"type": "integer"}, "chunk_count": {"type": "integer"}}, "required": ["source_path", "index_path", "mode", "status", "current", "file_count", "chunk_count"], "additionalProperties": false}},
  "error_kinds": ["configuration", "filesystem", "internal", "output_validation"], "effects": ["filesystem_read", "filesystem_write"],
  "preflight_checks": [{"id": "source-readable", "severity": "error", "description": "The vector source must exist and be readable."}, {"id": "index-destination-ready", "severity": "error", "description": "The index destination must be writable."}, {"id": "encoding-supported", "severity": "error", "description": "The configured text encoding must be available."}, {"id": "strategy-available", "severity": "error", "description": "The configured embedding and search strategy pair must be installed."}], "static_diagnostics": []
}
