{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "common-llm-task",
  "runtime_handler": "raticode.common_llm_task",
  "catalog": {"category": "ai", "summary": "Review, summarize, extract and more with a ready-made prompt", "docs_path": "/docs/nodes/common-llm-task"},
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "task": {"description": "Common prompt task family.", "enum": ["review", "summarize", "explain", "extract", "rewrite", "classify"], "x-rattish-case-insensitive": true},
      "target": {"description": "Text for the chosen task.", "type": "string"},
      "instructions": {"description": "Additional task criteria.", "type": "string"},
      "provider": {"description": "Rattish provider ID.", "type": "string", "minLength": 1, "x-rattish-role": "provider_id"},
      "profile": {"description": "Optional compatible deployment profile.", "type": ["string", "null"]},
      "model": {"description": "Model ID supported by the selected provider.", "type": "string", "minLength": 1},
      "effort": {"description": "Effort choice supported by that model.", "type": "string", "minLength": 1},
      "working_dir": {"description": "Working directory resolved from the workflow project.", "type": "string", "x-rattish-type": "Path"},
      "memory": {"description": "Provider memory scope.", "enum": ["none", "run", "all"]},
      "output_schema": {"description": "Inline successful-output JSON Schema.", "type": ["object", "null"]},
      "output_schema_path": {"description": "File containing the successful-output schema.", "type": ["string", "null"], "x-rattish-type": "Path"},
      "repair_attempts": {"description": "Bounded structured-output repair attempts.", "type": "integer", "minimum": 0, "maximum": 3},
      "cache": {"description": "Reuse a saved answer for this long, such as 30m, 12h, 7d or 2w, at most 365d.", "type": ["string", "null"], "pattern": "^[1-9][0-9]*(s|m|h|d|w)$"},
      "fallback": {"description": "Providers to try next when this one can't serve the step.", "type": "array", "maxItems": 4, "items": {"type": "object", "properties": {"provider": {"description": "Provider ID to try.", "type": "string", "minLength": 1, "x-rattish-role": "provider_id"}, "profile": {"description": "Optional profile or account for that provider.", "type": ["string", "null"]}, "model": {"description": "Optional model for that provider.", "type": "string", "minLength": 1}, "effort": {"description": "Optional effort for that model.", "type": "string", "minLength": 1}}, "required": ["provider"], "additionalProperties": false}}
    },
    "required": ["provider"],
    "allOf": [{"not": {"properties": {"output_schema": {"type": "object"}, "output_schema_path": {"type": "string"}}, "required": ["output_schema", "output_schema_path"]}}],
    "additionalProperties": false
  },
  "defaults": {"task": "summarize", "target": "", "instructions": "", "profile": null, "working_dir": ".", "memory": "none", "output_schema": null, "output_schema_path": null, "repair_attempts": 0, "cache": null, "fallback": []},
  "computed_defaults": {
    "model": {"source": "provider_contract", "field": "default_model", "description": "Resolve and freeze the provider default model."},
    "effort": {"source": "provider_contract", "field": "default_effort", "description": "Resolve and freeze the provider default effort."}
  },
  "input_ports": {"mode": "open", "ports": {}, "additional_port_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema"}, "additional_port_delivery": {"delivery": "local_binding", "name_transform": "identity", "encoding": "identity"}},
  "success_output": {"kind": "configuration_selected", "schema_fields": ["output_schema", "output_schema_path"], "default_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string"}},
  "error_kinds": ["cancelled", "configuration", "filesystem", "internal", "output_validation", "provider", "timeout"],
  "effects": ["filesystem_read", "filesystem_write", "network", "provider"],
  "preflight_checks": [
    {"id": "provider-available", "severity": "error", "description": "The selected provider runtime must be installed and available."},
    {"id": "profile-compatible", "severity": "error", "description": "A selected deployment profile must exist and support the provider."},
    {"id": "fallback-provider-available", "severity": "warning", "description": "Each fallback provider should be installed and available, so the step can switch to it."},
    {"id": "working-dir-available", "severity": "error", "description": "The working directory must exist and be accessible."}
  ],
  "static_diagnostics": []
}
