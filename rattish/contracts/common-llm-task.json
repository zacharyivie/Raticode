{
  "$schema": "../schemas/node-contract.schema.json",
  "contract_version": 1,
  "node_type": "common-llm-task",
  "runtime_handler": "raticode.common_llm_task",
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "task": {"enum": ["review", "summarize", "explain", "extract", "rewrite", "classify"], "x-rattish-case-insensitive": true},
      "target": {"type": "string"},
      "instructions": {"type": "string"},
      "provider": {"type": "string", "minLength": 1, "x-rattish-role": "provider_id"},
      "profile": {"type": ["string", "null"]},
      "model": {"type": "string", "minLength": 1},
      "effort": {"type": "string", "minLength": 1},
      "working_dir": {"type": "string", "x-rattish-type": "Path"},
      "memory": {"enum": ["none", "run", "all"]},
      "output_schema": {"type": ["object", "null"]},
      "output_schema_path": {"type": ["string", "null"], "x-rattish-type": "Path"},
      "repair_attempts": {"type": "integer", "minimum": 0, "maximum": 3}
    },
    "required": ["provider"],
    "allOf": [{"not": {"properties": {"output_schema": {"type": "object"}, "output_schema_path": {"type": "string"}}, "required": ["output_schema", "output_schema_path"]}}],
    "additionalProperties": false
  },
  "defaults": {"task": "summarize", "target": "", "instructions": "", "profile": null, "working_dir": ".", "memory": "none", "output_schema": null, "output_schema_path": null, "repair_attempts": 0},
  "computed_defaults": {
    "model": {"source": "provider_contract", "field": "default_model", "description": "Resolve and freeze the provider default model."},
    "effort": {"source": "provider_contract", "field": "default_effort", "description": "Resolve and freeze the provider default effort."}
  },
  "input_ports": {"mode": "open", "ports": {}, "additional_port_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema"}, "additional_port_delivery": {"delivery": "local_binding", "name_transform": "identity", "encoding": "identity"}},
  "success_output": {"kind": "configuration_selected", "schema_fields": ["output_schema", "output_schema_path"], "default_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string"}},
  "error_kinds": ["cancelled", "configuration", "filesystem", "internal", "output_validation", "provider", "timeout"],
  "effects": ["filesystem_read", "filesystem_write", "network", "provider"],
  "preflight_checks": [
    {"id": "provider-available", "severity": "error", "description": "The selected provider runtime must be installed and available."},
    {"id": "profile-compatible", "severity": "error", "description": "A selected deployment profile must exist and support the provider."},
    {"id": "working-dir-available", "severity": "error", "description": "The working directory must exist and be accessible."}
  ],
  "static_diagnostics": []
}
