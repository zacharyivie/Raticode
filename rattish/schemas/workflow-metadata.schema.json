{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:rattish:schema:workflow-metadata-1.json",
  "title": "Raticode workflow editor metadata",
  "type": "object",
  "properties": {
    "metadataVersion": {"const": 1},
    "canvas": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        },
        "zoom": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "pan": {
          "type": "object",
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "required": ["nodes", "zoom", "pan"],
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "properties": {
        "foldedDeclarations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": ["foldedDeclarations"],
      "additionalProperties": false
    }
  },
  "required": ["metadataVersion", "canvas", "editor"],
  "additionalProperties": false
}
