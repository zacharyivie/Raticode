{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:rattish:schema:run-1.json",
  "title": "Rattish run artifact version 1",
  "type": "object",
  "$defs": {
    "provider_choice": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "profile": {"type": ["string", "null"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      },
      "required": ["provider", "profile", "model", "effort"],
      "additionalProperties": false
    },
    "fallback_reason": {
      "enum": ["rate_limit", "overloaded", "signed_out", "not_installed"]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage_totals": {
      "description": "Provider calls and what they reported. A null token or cost total means no call reported it: unknown, not zero.",
      "type": "object",
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "reported_calls": {"type": "integer", "minimum": 0},
        "partial_calls": {"type": "integer", "minimum": 0},
        "unknown_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "cost_reported_calls": {"type": "integer", "minimum": 0},
        "cost_unknown_calls": {"type": "integer", "minimum": 0},
        "cached_results": {
          "description": "Activations answered from the result cache. They made no call and count as 0 tokens and $0.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "calls",
        "reported_calls",
        "partial_calls",
        "unknown_calls",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_usd",
        "cost_reported_calls",
        "cost_unknown_calls"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "code": {"type": "string", "pattern": "^RATTISH_[A-Z0-9_]+$"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      },
      "required": ["kind", "code", "message", "details"],
      "additionalProperties": false
    }
  },
  "properties": {
    "run_artifact_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["passed", "failed", "preflight_failed", "invalid_inputs", "running", "stopped", "interrupted"]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "compilation_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "cache_hit": {"type": "boolean"}
      },
      "required": ["path", "source_fingerprint", "compilation_fingerprint", "cache_hit"],
      "additionalProperties": false
    },
    "runner_pid": {"type": "integer", "minimum": 1},
    "runner_start": {
      "description": "Identifies the runner process beyond its PID, so a PID reused after a restart doesn't make an ended run look active. Absent where the OS can't provide it.",
      "type": "string",
      "minLength": 1
    },
    "compiled_snapshot": {
      "description": "The validated IR used by this execution, retained for historical graph inspection. Optional for artifacts written before snapshot support.",
      "type": "object",
      "properties": {
        "ir_version": {"const": 1},
        "workflow": {"type": "object"},
        "source": {"type": "object"},
        "nodes": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["ir_version", "workflow", "source", "nodes"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "object"}
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "type": {
            "enum": ["workflow_started", "node_started", "node_retried", "node_fell_back", "node_stopped", "node_completed", "workflow_completed"]
          },
          "at": {"type": "string", "format": "date-time"},
          "node_id": {"type": "string", "minLength": 1},
          "run_number": {"type": "integer", "minimum": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "activation_lineage_id": {"type": "string", "minLength": 1},
          "activation_group_id": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "outcome": {"enum": ["success", "allowed_failure", "failure"]},
          "reused": {"const": true},
          "cached": {"const": true},
          "provider": {"$ref": "#/$defs/provider_choice"},
          "from_provider": {"$ref": "#/$defs/provider_choice"},
          "fallback_reason": {"$ref": "#/$defs/fallback_reason"},
          "status": {
            "enum": ["passed", "failed", "preflight_failed", "invalid_inputs", "running", "stopped", "interrupted"]
          }
        },
        "required": ["sequence", "type", "at"],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "run_number": {"type": "integer", "minimum": 1},
          "activation_lineage_id": {"type": "string", "minLength": 1},
          "activation_group_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "outcome": {"enum": ["success", "allowed_failure", "failure"]},
          "output": true,
          "error": {"$ref": "#/$defs/error"},
          "reused_from_run_id": {"type": "string", "minLength": 1},
          "cached_at": {
            "description": "Present when the output came from the result cache: when that answer was first made. The activation made no provider call.",
            "type": "string",
            "format": "date-time"
          },
          "usage": {"$ref": "#/$defs/usage_totals"},
          "provider": {
            "description": "The provider, profile, model and effort of the node's last attempt: the one that answered when the node succeeded. Absent for nodes that call no model provider and from runs saved before it was recorded.",
            "$ref": "#/$defs/provider_choice"
          },
          "fallbacks": {
            "description": "Each switch to the next fallback provider, in order, with the availability error that caused it.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {"$ref": "#/$defs/provider_choice"},
                "to": {"$ref": "#/$defs/provider_choice"},
                "reason": {"$ref": "#/$defs/fallback_reason"},
                "message": {"type": "string"}
              },
              "required": ["from", "to", "reason", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "node_id",
          "run_number",
          "activation_lineage_id",
          "activation_group_id",
          "started_at",
          "finished_at",
          "duration_ms",
          "outcome",
          "output",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {"type": "object"},
    "latest_node_outputs": {"type": "object"},
    "error": {"$ref": "#/$defs/error"},
    "trigger_event_count": {"type": "integer", "minimum": 0},
    "started_by": {
      "description": "How the run started: from the app or command line (manual), by a trigger, from the paired phone, or by Rem or one of its workers. Runs saved before this was recorded have none.",
      "enum": ["manual", "trigger", "phone", "rem"]
    },
    "usage": {
      "description": "The run's provider calls, in total and per node, and the usage limits it ran with. Absent from runs saved before usage tracking.",
      "type": "object",
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "reported_calls": {"type": "integer", "minimum": 0},
        "partial_calls": {"type": "integer", "minimum": 0},
        "unknown_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "cost_reported_calls": {"type": "integer", "minimum": 0},
        "cost_unknown_calls": {"type": "integer", "minimum": 0},
        "cached_results": {"type": "integer", "minimum": 0},
        "nodes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/usage_totals"}
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_tokens": {"type": ["integer", "null"], "minimum": 1},
            "max_cost_usd": {"type": ["number", "null"], "exclusiveMinimum": 0}
          },
          "required": ["max_tokens", "max_cost_usd"],
          "additionalProperties": false
        }
      },
      "required": [
        "calls",
        "reported_calls",
        "partial_calls",
        "unknown_calls",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_usd",
        "cost_reported_calls",
        "cost_unknown_calls",
        "nodes",
        "limits"
      ],
      "additionalProperties": false
    },
    "saved_values": {
      "description": "What the run saved of its inputs and trigger events, beside its record as <run_id>.inputs (owner-only), so it can be resumed or run again. Password inputs are never saved and are listed as withheld. Absent when the run had neither, or was saved before Raticode kept them.",
      "type": "object",
      "properties": {
        "saved": {"type": "boolean"},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "withheld_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "trigger_events": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      },
      "required": ["saved", "inputs", "withheld_inputs", "trigger_events"],
      "additionalProperties": false
    },
    "rerun_of": {
      "description": "The run whose saved inputs and trigger events this run was started again with.",
      "type": "string",
      "minLength": 1
    },
    "resumed_from": {
      "type": "object",
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "rerun_nodes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reused_runs": {"type": "integer", "minimum": 0},
        "not_reused_runs": {"type": "integer", "minimum": 0}
      },
      "required": ["run_id", "rerun_nodes"],
      "additionalProperties": false
    }
  },
  "required": [
    "run_artifact_version",
    "run_id",
    "status",
    "workflow",
    "source",
    "started_at",
    "finished_at",
    "duration_ms",
    "input_names",
    "diagnostics",
    "events",
    "runs",
    "outputs",
    "latest_node_outputs",
    "error"
  ],
  "additionalProperties": false
}
