{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:rattish:schema:run-1.json",
  "title": "Rattish run artifact version 1",
  "type": "object",
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "code": {"type": "string", "pattern": "^RATTISH_[A-Z0-9_]+$"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      },
      "required": ["kind", "code", "message", "details"],
      "additionalProperties": false
    }
  },
  "properties": {
    "run_artifact_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["passed", "failed", "preflight_failed", "invalid_inputs", "running", "stopped", "interrupted"]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "compilation_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "cache_hit": {"type": "boolean"}
      },
      "required": ["path", "source_fingerprint", "compilation_fingerprint", "cache_hit"],
      "additionalProperties": false
    },
    "runner_pid": {"type": "integer", "minimum": 1},
    "compiled_snapshot": {
      "description": "The validated IR used by this execution, retained for historical graph inspection. Optional for artifacts written before snapshot support.",
      "type": "object",
      "properties": {
        "ir_version": {"const": 1},
        "workflow": {"type": "object"},
        "source": {"type": "object"},
        "nodes": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["ir_version", "workflow", "source", "nodes"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_names": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "object"}
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "type": {
            "enum": ["workflow_started", "node_completed", "workflow_completed"]
          },
          "at": {"type": "string", "format": "date-time"},
          "node_id": {"type": "string", "minLength": 1},
          "run_number": {"type": "integer", "minimum": 1},
          "outcome": {"enum": ["success", "allowed_failure", "failure"]},
          "status": {
            "enum": ["passed", "failed", "preflight_failed", "invalid_inputs", "running", "stopped", "interrupted"]
          }
        },
        "required": ["sequence", "type", "at"],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "run_number": {"type": "integer", "minimum": 1},
          "activation_lineage_id": {"type": "string", "minLength": 1},
          "activation_group_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "outcome": {"enum": ["success", "allowed_failure", "failure"]},
          "output": true,
          "error": {"$ref": "#/$defs/error"}
        },
        "required": [
          "node_id",
          "run_number",
          "activation_lineage_id",
          "activation_group_id",
          "started_at",
          "finished_at",
          "duration_ms",
          "outcome",
          "output",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {"type": "object"},
    "latest_node_outputs": {"type": "object"},
    "error": {"$ref": "#/$defs/error"}
  },
  "required": [
    "run_artifact_version",
    "run_id",
    "status",
    "workflow",
    "source",
    "started_at",
    "finished_at",
    "duration_ms",
    "input_names",
    "diagnostics",
    "events",
    "runs",
    "outputs",
    "latest_node_outputs",
    "error"
  ],
  "additionalProperties": false
}
