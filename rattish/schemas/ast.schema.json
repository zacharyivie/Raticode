{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:rattish:schema:ast-1.json",
  "title": "Rattish source AST",
  "description": "Source-faithful strict-parser AST. It contains no expanded defaults or resolved contracts.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "source_id": {"type": ["string", "null"]},
    "span": {"$ref": "#/$defs/span"},
    "version_directive": {"$ref": "#/$defs/version_directive"},
    "workflow": {"$ref": "#/$defs/workflow_declaration"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node_declaration"}
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "source_id",
    "span",
    "version_directive",
    "workflow",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "object",
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      },
      "required": ["offset", "line", "column"],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "identifier": {
      "type": "object",
      "properties": {
        "kind": {"const": "identifier"},
        "source": {"type": "string"},
        "canonical": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "canonical", "span"],
      "additionalProperties": false
    },
    "version_directive": {
      "type": "object",
      "properties": {
        "kind": {"const": "version_directive"},
        "keyword_source": {"type": "string"},
        "value_source": {"type": "string"},
        "value": {"type": "integer", "minimum": 1},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "value_source", "value", "span"],
      "additionalProperties": false
    },
    "workflow_declaration": {
      "type": "object",
      "properties": {
        "kind": {"const": "workflow_declaration"},
        "keyword_source": {"type": "string"},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "entries", "span"],
      "additionalProperties": false
    },
    "node_declaration": {
      "type": "object",
      "properties": {
        "kind": {"const": "node_declaration"},
        "keyword_source": {"type": "string"},
        "name": {"$ref": "#/$defs/identifier"},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/node_entry"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "name", "entries", "span"],
      "additionalProperties": false
    },
    "node_entry": {
      "oneOf": [
        {"$ref": "#/$defs/field"},
        {"$ref": "#/$defs/needs_entry"},
        {"$ref": "#/$defs/routes_entry"},
        {"$ref": "#/$defs/bindings_entry"}
      ]
    },
    "field": {
      "type": "object",
      "properties": {
        "kind": {"const": "field"},
        "name": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/value"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "name", "value", "span"],
      "additionalProperties": false
    },
    "needs_entry": {
      "type": "object",
      "properties": {
        "kind": {"const": "needs"},
        "keyword_source": {"type": "string"},
        "form": {"enum": ["scalar", "list"]},
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "form", "nodes", "span"],
      "additionalProperties": false
    },
    "routes_entry": {
      "type": "object",
      "properties": {
        "kind": {"const": "routes"},
        "keyword_source": {"type": "string"},
        "form": {"enum": ["scalar", "list"]},
        "routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "form", "routes", "span"],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "kind": {"const": "route"},
        "target": {"$ref": "#/$defs/identifier"},
        "mode": {"enum": ["unconditional", "when", "otherwise"]},
        "predicate": {"$ref": "#/$defs/predicate"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "target", "mode", "span"],
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "when"}}},
          "then": {"required": ["predicate"]},
          "else": {"not": {"required": ["predicate"]}}
        }
      ],
      "additionalProperties": false
    },
    "bindings_entry": {
      "type": "object",
      "properties": {
        "kind": {"const": "bindings"},
        "keyword_source": {"type": "string"},
        "bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/binding"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "bindings", "span"],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "binding"},
            "form": {"const": "compact"},
            "name": {"$ref": "#/$defs/identifier"},
            "value": {"$ref": "#/$defs/value"},
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "form", "name", "value", "span"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "binding"},
            "form": {"const": "expanded"},
            "name": {"$ref": "#/$defs/identifier"},
            "entries": {
              "type": "array",
              "items": {"$ref": "#/$defs/binding_entry"},
              "minItems": 1,
              "maxItems": 2,
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {"kind": {"const": "from"}},
                    "required": ["kind"]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {"kind": {"const": "default"}},
                    "required": ["kind"]
                  },
                  "minContains": 0,
                  "maxContains": 1
                }
              ]
            },
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "form", "name", "entries", "span"],
          "additionalProperties": false
        }
      ]
    },
    "binding_entry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "from"},
            "keyword_source": {"type": "string"},
            "reference": {"$ref": "#/$defs/reference"},
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "keyword_source", "reference", "span"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "default"},
            "keyword_source": {"type": "string"},
            "value": {"$ref": "#/$defs/value"},
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "keyword_source", "value", "span"],
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "oneOf": [
        {"$ref": "#/$defs/string_value"},
        {"$ref": "#/$defs/identifier_value"},
        {"$ref": "#/$defs/integer_value"},
        {"$ref": "#/$defs/number_value"},
        {"$ref": "#/$defs/boolean_value"},
        {"$ref": "#/$defs/none_value"},
        {"$ref": "#/$defs/null_value"},
        {"$ref": "#/$defs/duration_value"},
        {"$ref": "#/$defs/json_value"},
        {"$ref": "#/$defs/reference"},
        {"$ref": "#/$defs/expression_value"},
        {"$ref": "#/$defs/list_value"},
        {"$ref": "#/$defs/map_value"}
      ]
    },
    "expression_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "expression"},
        "expression": {"$ref": "#/$defs/predicate"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "expression", "span"],
      "additionalProperties": false
    },
    "identifier_value": {
      "type": "object",
      "description": "An identifier-valued field recognized by the grammar, such as a node type. Contract-owned closed enums are typed during semantic analysis.",
      "properties": {
        "kind": {"const": "identifier_value"},
        "source": {"type": "string"},
        "canonical": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "canonical", "span"],
      "additionalProperties": false
    },
    "string_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "string"},
        "style": {"enum": ["bare", "quoted", "block"]},
        "source": {"type": "string"},
        "value": {"type": "string"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "style", "source", "value", "span"],
      "additionalProperties": false
    },
    "integer_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "integer"},
        "source": {"type": "string"},
        "value": {"type": "integer"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "number_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "number"},
        "source": {"type": "string"},
        "value": {"type": "number"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "boolean_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "boolean"},
        "source": {"type": "string"},
        "value": {"type": "boolean"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "none_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "none"},
        "source": {"type": "string"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "span"],
      "additionalProperties": false
    },
    "null_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "null"},
        "source": {"type": "string"},
        "value": {"type": "null"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "duration_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "duration"},
        "source": {"type": "string"},
        "amount": {"type": "integer", "minimum": 1},
        "unit_source": {"type": "string"},
        "canonical_unit": {"enum": ["ms", "s", "m", "h", "d"]},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "amount", "unit_source", "canonical_unit", "span"],
      "additionalProperties": false
    },
    "json_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "json"},
        "source": {"type": "string"},
        "value": {},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "list_value": {
      "type": "object",
      "properties": {
        "kind": {"const": "list"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/value"}},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "items", "span"],
      "additionalProperties": false
    },
    "map_value": {
      "type": "object",
      "description": "Entries remain ordered so duplicate keys and their spans survive parsing for semantic diagnostics.",
      "properties": {
        "kind": {"const": "map"},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/map_entry"},
          "minItems": 1
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "entries", "span"],
      "additionalProperties": false
    },
    "map_entry": {
      "type": "object",
      "properties": {
        "kind": {"const": "map_entry"},
        "key": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"$ref": "#/$defs/map_key_string"}
          ]
        },
        "value": {"$ref": "#/$defs/value"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "key", "value", "span"],
      "additionalProperties": false
    },
    "map_key_string": {
      "type": "object",
      "properties": {
        "kind": {"const": "string"},
        "style": {"const": "quoted"},
        "source": {"type": "string"},
        "value": {"type": "string"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "style", "source", "value", "span"],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "kind": {"const": "reference"},
        "root": {"$ref": "#/$defs/identifier"},
        "selectors": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference_selector"}
        },
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "root", "selectors", "span"],
      "additionalProperties": false
    },
    "reference_selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "member"},
            "notation": {"enum": ["dot", "bracket"]},
            "source": {"type": "string"},
            "role": {"enum": ["identifier", "json_member"]},
            "canonical": {"type": ["string", "null"]},
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "notation", "source", "role", "canonical", "span"],
          "allOf": [
            {
              "if": {"properties": {"role": {"const": "identifier"}}},
              "then": {
                "properties": {
                  "canonical": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  }
                }
              },
              "else": {"properties": {"canonical": {"type": "null"}}}
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "index"},
            "source": {"type": "string"},
            "value": {"type": "integer", "minimum": 0},
            "span": {"$ref": "#/$defs/span"}
          },
          "required": ["kind", "source", "value", "span"],
          "additionalProperties": false
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {"$ref": "#/$defs/logical_predicate"},
        {"$ref": "#/$defs/not_predicate"},
        {"$ref": "#/$defs/group_predicate"},
        {"$ref": "#/$defs/exists_predicate"},
        {"$ref": "#/$defs/null_test_predicate"},
        {"$ref": "#/$defs/comparison_predicate"},
        {"$ref": "#/$defs/status_predicate"},
        {"$ref": "#/$defs/reference_predicate"}
      ]
    },
    "logical_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "logical"},
        "operator": {"enum": ["and", "or"]},
        "operator_source": {"type": "string"},
        "left": {"$ref": "#/$defs/predicate"},
        "right": {"$ref": "#/$defs/predicate"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "operator", "operator_source", "left", "right", "span"],
      "additionalProperties": false
    },
    "not_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "not"},
        "operator_source": {"type": "string"},
        "operand": {"$ref": "#/$defs/predicate"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "operator_source", "operand", "span"],
      "additionalProperties": false
    },
    "group_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "group"},
        "operand": {"$ref": "#/$defs/predicate"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "operand", "span"],
      "additionalProperties": false
    },
    "exists_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "exists"},
        "keyword_source": {"type": "string"},
        "reference": {"$ref": "#/$defs/reference"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "keyword_source", "reference", "span"],
      "additionalProperties": false
    },
    "null_test_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "null_test"},
        "reference": {"$ref": "#/$defs/reference"},
        "operator": {"enum": ["is_null", "is_not_null"]},
        "operator_source": {"type": "string"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "reference", "operator", "operator_source", "span"],
      "additionalProperties": false
    },
    "comparison_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "comparison"},
        "operator": {"enum": ["==", "!=", "<", "<=", ">", ">=", "contains", "matches"]},
        "operator_source": {"type": "string"},
        "left": {"$ref": "#/$defs/comparable"},
        "right": {"$ref": "#/$defs/comparable"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "operator", "operator_source", "left", "right", "span"],
      "additionalProperties": false
    },
    "status_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "status"},
        "source": {"type": "string"},
        "value": {"enum": ["succeeded", "failed"]},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "source", "value", "span"],
      "additionalProperties": false
    },
    "reference_predicate": {
      "type": "object",
      "properties": {
        "kind": {"const": "reference_predicate"},
        "reference": {"$ref": "#/$defs/reference"},
        "span": {"$ref": "#/$defs/span"}
      },
      "required": ["kind", "reference", "span"],
      "additionalProperties": false
    },
    "comparable": {
      "oneOf": [
        {"$ref": "#/$defs/reference"},
        {"$ref": "#/$defs/string_value"},
        {"$ref": "#/$defs/integer_value"},
        {"$ref": "#/$defs/number_value"},
        {"$ref": "#/$defs/boolean_value"},
        {"$ref": "#/$defs/null_value"}
      ]
    }
  }
}
