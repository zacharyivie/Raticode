(* Rattish 1 review draft.
   Keywords compare case-insensitively.
   INDENT, DEDENT, NEWLINE, and the scalar tokens are defined by lexical-spec.md. *)

document              = separators, version-directive, separators,
                        workflow-declaration, separators,
                        { node-declaration, separators }, EOF ;

version-directive     = ("Rattish" | "Radish"), ":", hspace, INTEGER, line-end ;

workflow-declaration = "Workflow", ":", line-end, INDENT,
                        workflow-entry, { workflow-entry }, DEDENT ;

workflow-entry        = generic-field ;

node-declaration      = "Node", hspace, IDENTIFIER, ":", line-end, INDENT,
                        node-entry, { node-entry }, DEDENT ;

node-entry            = type-field
                      | needs-field
                      | to-field
                      | with-field
                      | generic-field ;

type-field            = "type", ":", hspace, IDENTIFIER, line-end ;

needs-field           = "needs", ":", hspace, IDENTIFIER, line-end
                      | "needs", ":", NEWLINE, INDENT,
                        identifier-list, DEDENT ;

identifier-list       = identifier-item, { identifier-item } ;
identifier-item       = "-", hspace, IDENTIFIER, line-end ;

to-field              = "to", ":", hspace, route, line-end
                      | "to", ":", NEWLINE, INDENT,
                        route-list, DEDENT ;

route-list            = route-item, { route-item } ;
route-item            = "-", hspace, route, line-end ;
route                 = IDENTIFIER, [ hspace, "when", hspace, predicate ]
                      | IDENTIFIER, hspace, "otherwise" ;

with-field            = "with", ":", NEWLINE, INDENT,
                        binding, { binding }, DEDENT ;

binding               = IDENTIFIER, ":", hspace, binding-source, line-end
                      | IDENTIFIER, ":", NEWLINE, INDENT,
                        expanded-binding, DEDENT ;

binding-source        = expression | reference | scalar-value | json-container ;

expanded-binding      = from-entry, [ default-entry ]
                      | default-entry, from-entry ;
from-entry            = "from", ":", hspace, reference, line-end ;
default-entry         = "default", ":", hspace, value, line-end ;

generic-field         = field-name, ":", hspace, value, line-end
                      | field-name, ":", hspace, "|", NEWLINE, BLOCK_STRING
                      | field-name, ":", NEWLINE, INDENT,
                        block-value, DEDENT ;

block-value           = value-list | value-map ;

value-list            = value-item, { value-item } ;
value-item            = "-", hspace, value, line-end
                      | "-", NEWLINE, INDENT, value-map, DEDENT ;

value-map             = map-entry, { map-entry } ;
map-entry             = map-key, ":", hspace, value, line-end
                      | map-key, ":", NEWLINE, INDENT, block-value, DEDENT ;

map-key               = IDENTIFIER | QUOTED_STRING ;
field-name            = IDENTIFIER ;

value                 = scalar-value | json-container ;
scalar-value          = QUOTED_STRING
                      | BARE_STRING
                      | INTEGER
                      | NUMBER
                      | DURATION
                      | "true"
                      | "false"
                      | "none"
                      | "null"
                      | reference ;
json-container        = JSON_OBJECT | JSON_ARRAY ;

predicate             = or-expression ;
expression            = predicate ;
or-expression         = and-expression,
                        { hspace, "or", hspace, and-expression } ;
and-expression        = unary-expression,
                        { hspace, "and", hspace, unary-expression } ;
unary-expression      = [ "not", hspace ], predicate-primary ;

predicate-primary     = "(", opt-hspace, predicate, opt-hspace, ")"
                      | "exists", hspace, reference
                      | reference, hspace, null-test
                      | comparable, hspace, comparison-operator,
                        hspace, comparable
                      | "succeeded"
                      | "failed"
                      | reference ;

null-test             = "is", hspace, "null"
                      | "is", hspace, "not", hspace, "null" ;

comparison-operator   = "==" | "!=" | "<" | "<=" | ">" | ">="
                      | "contains" | "matches" ;

comparable            = reference
                      | QUOTED_STRING
                      | INTEGER
                      | NUMBER
                      | "true"
                      | "false"
                      | "null" ;

reference             = IDENTIFIER, { reference-selector } ;
reference-selector    = ".", reference-segment
                      | "[", QUOTED_STRING, "]"
                      | "[", INTEGER, "]" ;
reference-segment     = IDENTIFIER | INTEGER ;

separators            = { NEWLINE } ;
line-end              = [ hspace, COMMENT ], NEWLINE ;
opt-hspace            = { HSPACE } ;
hspace                = HSPACE, { HSPACE } ;

(* Lexical terminals supplied by the lexer:
   IDENTIFIER, INTEGER, NUMBER, DURATION, QUOTED_STRING, BARE_STRING,
   JSON_OBJECT, JSON_ARRAY, BLOCK_STRING, COMMENT, HSPACE,
   INDENT, DEDENT, NEWLINE, EOF. *)
