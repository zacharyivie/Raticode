.raticode/daily-todo-implementation/*
!.raticode/daily-todo-implementation/workflow.rattish
!.raticode/daily-todo-implementation/workflow.metadata.json
!.raticode/daily-todo-implementation/.raticodeignore
!.raticode/registry/
.raticode/registry/*
!.raticode/registry/radish/
.raticode/registry/radish/*
!.raticode/registry/radish/workspace-registry.json

# Virtual environments
# No trailing slash: worktrees often symlink .venv to the main checkout.
.venv
.uv-cache/
venv/
env/

# Hatch
.hatch/

# local dev reporting
/reports*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Wireframes for demo
wireframes/

# Type checking
.mypy_cache/
.pyright/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Empty read-only mount points Claude Code's sandbox puts in the folder it
# starts in while a sandboxed command runs (Raticode removes any a stopped turn
# leaves). None of these is part of the repository.
/.bashrc
/.bash_profile
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.idea
/.vscode
/.claude/settings.json
/.claude/settings.local.json
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/skills
/.claude/workflows
/.claude/routines
/.claude/output-styles
/.claude/launch.json
/.claude/scheduled_tasks.json
/.claude/loop.md

# Test scratch folders an agent made inside the checkout. Keep TMPDIR outside
# the repository: tests/conftest.py refuses to run with it inside.
/.scratch*/

# Environment
.env
.env.local
# No trailing slash: also ignore worktree symlinks to a shared node_modules.
node_modules
frontend/dist/
frontend/release/

# OS
.DS_Store
Thumbs.db

# Project-specific
*.db
*.sqlite
*.sqlite3
logs/

# Generated dependency audit evidence
audit-evidence/

# Local performance fixture builds
frontend/perf-dist/

# Screenshots and logs written by browser tests; nothing reads them back
frontend/artifacts/

# Disposable mobile conversation verification
/artifacts/mobile-conversation/

# docs/ keeps only files that scripts, tests and release tooling read. Notes,
# plans, reports and evidence live in the maintainer's Second Brain, and user
# documentation lives in website/docs/ (see AGENTS.md).
/docs/*
!/docs/releasing.md
!/docs/cli-parity.json
!/docs/security/
/docs/security/*
!/docs/security/release-verification.md
/mobile/android/docs/*
!/mobile/android/docs/releasing.md
!/mobile/android/docs/versioning.md
