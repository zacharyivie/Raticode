{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decrypted session record",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.identify"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "chat",
              "status",
              "files",
              "remote_approval"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "device_id",
        "device_name",
        "capabilities"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.ready"
        },
        "phone_device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "chat",
              "status",
              "files",
              "remote_approval"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "phone_to_desktop_topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "desktop_to_phone_topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "type",
        "phone_device_id",
        "capabilities",
        "phone_to_desktop_topic",
        "desktop_to_phone_topic"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.ready_ack"
        },
        "phone_device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "phone_device_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.resume"
        },
        "last_received_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "last_received_sequence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.resync_required"
        },
        "reason": {
          "enum": [
            "history_expired",
            "cursor_invalid"
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event.chunk"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1366
        }
      },
      "required": [
        "type",
        "event_id",
        "part",
        "total",
        "sha256",
        "data"
      ],
      "additionalProperties": false
    }
  ]
}
