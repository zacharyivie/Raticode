{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "invitation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "desktop_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "desktop_name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1
    },
    "relay": {
      "type": "string",
      "pattern": "^https://[^/@?#:]+(?::443)?/?$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "desktop_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "version",
    "invitation_id",
    "desktop_id",
    "desktop_name",
    "relay",
    "expires_at",
    "desktop_key",
    "secret"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:mobile:invitation:v1",
  "title": "Decoded pairing invitation; never persist secret"
}
