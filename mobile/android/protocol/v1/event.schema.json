{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "enum": [
        "chat.submit",
        "chat.accepted",
        "chat.message",
        "request.cancel",
        "request.status",
        "thread.snapshot",
        "swarm.snapshot",
        "approval.required",
        "approval.resolve",
        "file.offer",
        "file.request",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "id",
    "thread_id",
    "request_id",
    "sequence",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raticode:mobile:application:v1",
  "title": "Decrypted Raticode application event v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "chat.submit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "attachment_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 1
              }
            },
            "required": [
              "text",
              "attachment_ids"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "chat.accepted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "message_id"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "chat.message"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "attachment_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 1
              },
              "final": {
                "type": "boolean"
              }
            },
            "required": [
              "message_id",
              "text",
              "attachment_ids",
              "final"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.cancel"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "running",
                  "awaiting_approval",
                  "completed",
                  "failed",
                  "cancelled",
                  "cancel_requested"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "status",
              "detail"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread.snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 80
              },
              "project_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resource_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 100
              },
              "provider": {
                "type": "string",
                "maxLength": 80
              },
              "model": {
                "type": "string",
                "maxLength": 80
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "title",
              "project_id",
              "resource_ids",
              "provider",
              "model",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "swarm.snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "swarms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "swarm_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "status": {
                      "enum": [
                        "queued",
                        "running",
                        "awaiting_approval",
                        "completed",
                        "failed",
                        "cancelled"
                      ]
                    },
                    "detail": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "swarm_id",
                    "title",
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              }
            },
            "required": [
              "revision",
              "swarms"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.required"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "action_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "summary": {
                "type": "string",
                "maxLength": 1000
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "remote_allowed": {
                "type": "boolean"
              }
            },
            "required": [
              "approval_id",
              "action_digest",
              "summary",
              "expires_at",
              "remote_allowed"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.resolve"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "action_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "decision": {
                "enum": [
                  "approve",
                  "deny"
                ]
              }
            },
            "required": [
              "approval_id",
              "action_digest",
              "decision"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file.offer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "maxLength": 160
              },
              "mime": {
                "type": "string",
                "maxLength": 100
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10485760
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file_id",
              "name",
              "mime",
              "size",
              "sha256",
              "expires_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file.request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "file_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "unsupported_version",
                  "invalid_request",
                  "unauthorized",
                  "revoked",
                  "expired",
                  "rate_limited",
                  "too_large",
                  "not_found",
                  "conflict",
                  "internal"
                ]
              },
              "retryable": {
                "type": "boolean"
              },
              "detail": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "code",
              "retryable",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
