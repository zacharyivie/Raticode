{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "mode": {
      "enum": [
        "pair",
        "resume"
      ]
    },
    "direction": {
      "enum": [
        "phone_to_desktop",
        "desktop_to_phone"
      ]
    },
    "kind": {
      "enum": [
        "handshake",
        "transport"
      ]
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "body": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 2800
    }
  },
  "required": [
    "version",
    "session_id",
    "mode",
    "direction",
    "kind",
    "index",
    "body"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted opaque relay frame; authenticate before processing"
}
