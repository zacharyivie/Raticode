<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
      android:enabled="true"
      android:icon="@drawable/ic_mic_shortcut"
      android:shortcutId="talk-to-rem"
      android:shortcutLongLabel="@string/voice_shortcut_long"
      android:shortcutShortLabel="@string/voice_label">
    <intent
        android:action="dev.raticode.mobile.action.VOICE"
        android:targetClass="dev.raticode.mobile.voice.VoiceActivity"
        android:targetPackage="dev.raticode.mobile" />
  </shortcut>
  <!-- Run a workflow: the three workflows most recently run from a share appear as direct-share targets (WorkflowShareStore). -->
  <share-target android:targetClass="dev.raticode.mobile.share.WorkflowShareActivity">
    <data android:mimeType="text/plain" />
    <data android:mimeType="*/*" />
    <category android:name="dev.raticode.mobile.category.RUN_WORKFLOW" />
  </share-target>
</shortcuts>
