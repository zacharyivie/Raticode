{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "profile": {
      "const": "raticode-tls13-v2"
    },
    "invitation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "responder_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "responder_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "responder_role": {
      "const": "desktop"
    },
    "responder_spki_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relay": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$",
      "maxLength": 512
    },
    "pair_initiator_topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "pair_responder_topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "lan_endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "host",
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "profile",
    "invitation_id",
    "responder_id",
    "responder_name",
    "responder_role",
    "responder_spki_sha256",
    "secret",
    "expires_at",
    "relay",
    "pair_initiator_topic",
    "pair_responder_topic",
    "lan_endpoint"
  ],
  "additionalProperties": false
}
