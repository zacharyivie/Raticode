{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.bind"
        },
        "version": {
          "const": 2
        },
        "profile": {
          "const": "raticode-tls13-v2"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "mode": {
          "enum": [
            "pair",
            "resume"
          ]
        },
        "initiator_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responder_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "initiator_role": {
          "enum": [
            "controller",
            "desktop"
          ]
        },
        "responder_role": {
          "const": "desktop"
        },
        "invitation_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "version",
        "profile",
        "session_id",
        "mode",
        "initiator_id",
        "responder_id",
        "initiator_role",
        "responder_role",
        "invitation_sha256",
        "secret"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "pair"
              }
            }
          },
          "then": {
            "properties": {
              "invitation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              }
            }
          },
          "else": {
            "properties": {
              "invitation_sha256": {
                "type": "null"
              },
              "secret": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.ready"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "role": {
          "enum": [
            "controller",
            "desktop"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "chat",
              "status",
              "files",
              "fleet.read",
              "worker.execute",
              "remote_approval"
            ]
          },
          "maxItems": 6,
          "uniqueItems": true
        },
        "initiator_topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "responder_topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "trust_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "device_id",
        "role",
        "capabilities",
        "initiator_topic",
        "responder_topic",
        "trust_revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "controller"
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "not": {
                  "contains": {
                    "const": "worker.execute"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.ready_ack"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "trust_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "device_id",
        "trust_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.pending"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "device_id",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.resume"
        },
        "last_received_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "last_received_sequence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.resync_required"
        },
        "reason": {
          "enum": [
            "history_expired",
            "cursor_invalid"
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
