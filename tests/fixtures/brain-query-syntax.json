{
  "comment": "Second Brain query syntax. frontend/src/lib/secondBrain.test.mjs runs these through parseQuery and tests/unit/test_brain_queries.py through parse_query; both must give exactly this.",
  "cases": [
    {
      "name": "words, a phrase, an exclusion and fields",
      "query": "event \"append only\" -draft tag:Architecture type:note published:2025..2026-06",
      "expected": {
        "terms": [
          "event"
        ],
        "phrases": [
          "append only"
        ],
        "exclude": [
          "draft"
        ],
        "any": false,
        "filters": {
          "tags": [
            "architecture"
          ],
          "types": [
            "note"
          ]
        },
        "date": {
          "field": "published",
          "from": "2025-01-01",
          "to": "2026-06-30"
        },
        "clauses": [
          {
            "start": 27,
            "end": 43,
            "field": "tags",
            "value": "Architecture",
            "negated": false
          },
          {
            "start": 44,
            "end": 53,
            "field": "types",
            "value": "note",
            "negated": false
          },
          {
            "start": 54,
            "end": 77,
            "field": "date",
            "value": "2025..2026-06",
            "negated": false
          }
        ],
        "errors": []
      }
    },
    {
      "name": "unknown field, bad date and an unclosed quote",
      "query": "colour:red published:soon \"open phrase tag:ok",
      "expected": {
        "terms": [],
        "phrases": [],
        "exclude": [],
        "any": false,
        "filters": {},
        "date": null,
        "clauses": [],
        "errors": [
          {
            "start": 0,
            "end": 10,
            "text": "colour:red",
            "message": "“colour:” is not a search field. Use one of type:, tag:, author:, domain:, project:, folder:, in:, state:, origin:, brain:, modified:, added:, published:, captured:, generated:"
          },
          {
            "start": 11,
            "end": 25,
            "text": "published:soon",
            "message": "“soon” is not a date range. Use 2026, 2026-03 or 2025..2026-06."
          },
          {
            "start": 26,
            "end": 45,
            "text": "\"open phrase tag:ok",
            "message": "Close the quotation mark to search for this phrase."
          }
        ]
      }
    },
    {
