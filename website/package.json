{
  "name": "raticode-website",
  "private": true,
  "type": "module",
  "description": "Raticode product website and documentation, built with VitePress.",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "typecheck": "vue-tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run check:versions && npm run typecheck && npm run build && npm run check:links",
    "check:downloads": "node scripts/check-downloads.mjs",
    "set-release": "node scripts/set-release.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "vite": "^6.4.6"
  }
}
